{
  "compilerOptions": {
    "target": "ES2022",
    // Node原生ESM规则: 相对导入必须写.js后缀,漏写时编译就会报错(而不是运行时才报错)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // TS编译后的JS文件将输出到此目录
    "outDir": "dist",
    // 编译时会以此目录为基准,保留内部目录结构输出到outDir
    "rootDir": "src",
    "strict": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ]
}